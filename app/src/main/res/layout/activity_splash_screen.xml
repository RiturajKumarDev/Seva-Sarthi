<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainSplashLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/splash_gradient_bg"
    tools:context=".SplashActivity">

    <!-- Animated Background Floating Elements -->
    <View
        android:id="@+id/circle1"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-110dp"
        android:alpha="0.12"
        android:background="@drawable/circle_shape_gold" />

    <View
        android:id="@+id/circle2"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-170dp"
        android:layout_marginBottom="-170dp"
        android:alpha="0.09"
        android:background="@drawable/circle_shape_orange" />

    <View
        android:id="@+id/circle3"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerInParent="true"
        android:alpha="0.06"
        android:background="@drawable/circle_shape_green" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Excellence Badge Pill -->
        <TextView
            android:id="@+id/tvServiceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#33E8C44B"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="✦ EXCELLENCE IN SERVICE ✦"
            android:textColor="@color/logo_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Logo Frame Container with Spring Scale Entrance & Rotating Gold Ring -->
        <RelativeLayout
            android:id="@+id/logoContainer"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_marginBottom="20dp">

            <!-- Rotating Gold Ring -->
            <ImageView
                android:id="@+id/logoBg"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:contentDescription="@string/app_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_ring" />

            <!-- Main App Logo Card with Double Ring Frame -->
            <FrameLayout
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_centerInParent="true"
                android:background="@drawable/profile_avatar_frame"
                android:padding="4dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/logo_dark_blue"
                    app:cardCornerRadius="62dp">

                    <ImageView
                        android:id="@+id/logoIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/app_logo_cir" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>
        </RelativeLayout>

        <!-- App Name with Glowing Gold Shadow -->
        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:shadowColor="#FFD700"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="16"
            android:text="@string/app_name"
            android:textColor="@color/logo_white"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="Smart Service &amp; Support Portal"
            android:textColor="@color/logo_gold_light"
            android:textSize="15sp" />

        <!-- Feature Chips Row (Verified | Instant | Secure) -->
        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="#1AFFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🛡️ Verified"
                android:textColor="@color/logo_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="#1AFFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="⚡ Instant"
                android:textColor="@color/logo_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1AFFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🔒 Secure"
                android:textColor="@color/logo_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Decorative Gold Gradient Line -->
        <View
            android:id="@+id/gradientLine"
            android:layout_width="150dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/gradient_line" />

    </LinearLayout>

    <!-- Modern Horizontal Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="220dp"
        android:layout_height="4dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:indeterminate="true"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="@color/logo_gold" />

    <!-- Footer Text -->
    <TextView
        android:id="@+id/tvFooterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif-light"
        android:text="Secured by Seva Sarthi &amp; Firebase"
        android:textColor="@color/logo_gold_light"
        android:textSize="11sp" />

</RelativeLayout>