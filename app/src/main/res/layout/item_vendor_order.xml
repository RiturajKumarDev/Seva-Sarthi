<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOrder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg_founder_header"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Category Tag & Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/user_type_badge_worker"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="WATER SUPPLY"
                android:textColor="@color/logo_white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status Pill Badge -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg_orange_accent"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="● PENDING"
                android:textColor="@color/logo_orange"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item Name -->
        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Water Delivery Order"
            android:textColor="@color/logo_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Quantity, Duration & Date Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1AFFFFFF"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Quantity & Duration -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_dairy"
                    app:tint="@color/logo_gold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quantity / Duration"
                        android:textColor="@color/logo_gold_light"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvQuantityInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 Liters (5 Days)"
                        android:textColor="@color/logo_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Order Date -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_today_tasks"
                    app:tint="@color/logo_gold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Date &amp; Time"
                        android:textColor="@color/logo_gold_light"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvOrderDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15/05/2025 10:30 AM"
                        android:textColor="@color/logo_gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Customer Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#26FFFFFF"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Customer Header with Avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/logo_gold" />

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ordered By: Customer Name"
                    android:textColor="@color/logo_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Phone Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/logo_gold_light" />

                <TextView
                    android:id="@+id/tvCustomerContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Phone: +91 9876543210"
                    android:textColor="@color/logo_gold_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Address Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/logo_gold_light" />

                <TextView
                    android:id="@+id/tvCustomerAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Address: Sector 12, Main Street"
                    android:textColor="@color/logo_gold_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Optional Order Notes -->
        <LinearLayout
            android:id="@+id/llNotesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#18FFFFFF"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_announcement"
                app:tint="@color/logo_gold" />

            <TextView
                android:id="@+id/tvOrderNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Special instructions..."
                android:textColor="@color/logo_white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Action Buttons Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Quick Contact Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallCustomer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="Call"
                android:textColor="@color/logo_white"
                android:textSize="12sp"
                app:icon="@drawable/ic_phone"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/logo_white"
                app:strokeColor="#40FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsAppCustomer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="WhatsApp"
                android:textColor="@color/logo_green"
                android:textSize="12sp"
                app:icon="@drawable/ic_whatsapp"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/logo_green"
                app:strokeColor="@color/logo_green" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Primary Action Button (Accept / Complete) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptOrder"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/logo_gold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:text="Accept Order"
                android:textColor="@color/logo_dark_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_check_circle"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/logo_dark_blue" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>