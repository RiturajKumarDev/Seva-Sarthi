<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/dashboard_gradient_bg"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Animated Background Circles -->
        <View
            android:id="@+id/bgCircle1"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-100dp"
            android:layout_marginEnd="-100dp"
            android:alpha="0.08"
            android:background="@drawable/circle_shape_gold" />

        <View
            android:id="@+id/bgCircle2"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="-80dp"
            android:layout_marginBottom="-80dp"
            android:alpha="0.06"
            android:background="@drawable/circle_shape_orange" />

        <View
            android:id="@+id/bgCircle3"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"
            android:alpha="0.04"
            android:background="@drawable/circle_shape_green" />

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- App Logo with Gold Glowing Frame Ring -->
            <RelativeLayout
                android:id="@+id/logoContainer"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/profile_avatar_frame"
                    android:padding="4dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="@color/logo_dark_blue"
                        app:cardCornerRadius="52dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/app_logo"
                            android:scaleType="fitCenter"
                            android:src="@drawable/app_logo_cir" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>
            </RelativeLayout>

            <!-- App Name & Subtitle -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:shadowColor="@color/logo_gold"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:text="@string/app_name"
                android:textColor="@color/logo_white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="28dp"
                android:text="Smart Service &amp; Support Portal"
                android:textColor="@color/logo_gold_light"
                android:textSize="12sp" />

            <!-- Login Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg_founder_header"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Back"
                        android:textColor="@color/logo_gold"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="20dp"
                        android:text="Sign in to your account to continue"
                        android:textColor="@color/logo_gold_light"
                        android:textSize="13sp" />

                    <!-- Language Selector Spinner -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Select Language"
                        android:textColor="@color/logo_gold_light"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spinnerLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/spinner_background" />

                    <!-- Error Text -->
                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/logo_orange"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Email Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Email Address"
                        app:boxStrokeColor="@color/logo_gold"
                        app:errorTextColor="@color/logo_orange"
                        app:hintTextColor="@color/logo_gold_light"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/logo_gold">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/logo_white"
                            android:textColorHint="@color/logo_gold_light" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Field with Built-in Toggle -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Password"
                        app:boxStrokeColor="@color/logo_gold"
                        app:errorTextColor="@color/logo_orange"
                        app:hintTextColor="@color/logo_gold_light"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/logo_gold_light"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:startIconTint="@color/logo_gold">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/logo_white"
                            android:textColorHint="@color/logo_gold_light" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Dummy Password Toggle View to avoid null pointers -->
                    <ImageView
                        android:id="@+id/ivShowPassword"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Forgot Password -->
                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:text="Forgot Password?"
                        android:textColor="@color/logo_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Login Button -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:enabled="true"
                            android:text="LOGIN TO ACCOUNT"
                            android:textColor="@color/logo_dark_blue"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/logo_gold"
                            app:cornerRadius="16dp"
                            app:elevation="6dp" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1.5dp"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:background="#33E8C44B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OR"
                            android:textColor="@color/logo_gold_light"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1.5dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="#33E8C44B" />
                    </LinearLayout>

                    <!-- Register Action -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegister"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:enabled="true"
                        android:text="CREATE NEW ACCOUNT"
                        android:textColor="@color/logo_gold"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:strokeColor="@color/logo_gold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Don't have an account? "
                            android:textColor="@color/logo_white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSignUp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="Register Here"
                            android:textColor="@color/logo_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Need assistance? "
                            android:textColor="@color/logo_white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSupport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="24x7 Support Center"
                            android:textColor="@color/logo_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="28dp"
                android:text="Secured by Seva Sarthi &amp; Firebase Auth"
                android:textColor="@color/logo_gold_light"
                android:textSize="11sp" />

        </LinearLayout>
    </RelativeLayout>
</ScrollView>