<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:id="@+id/formLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg_founder_header"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:background="@color/logo_gold" />

            <TextView
                android:id="@+id/tvFormTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Daily Issue Details"
                android:textColor="@color/logo_gold"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Category -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Select Specific Issue"
            android:textColor="@color/logo_white"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/spinner_background"
            android:popupBackground="@drawable/spinner_dropdown_bg" />

        <!-- Item Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Item / Request Name"
            app:boxStrokeColor="@color/logo_gold"
            app:hintTextColor="@color/logo_gold_light"
            app:startIconDrawable="@drawable/ic_issue"
            app:startIconTint="@color/logo_gold">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/logo_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Water Supply Specific Fields -->
        <LinearLayout
            android:id="@+id/layoutWaterSupplyFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Number of Days"
                app:boxStrokeColor="@color/logo_gold"
                app:hintTextColor="@color/logo_gold_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNumberOfDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/logo_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Items Per Day"
                app:boxStrokeColor="@color/logo_gold"
                app:hintTextColor="@color/logo_gold_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etItemsPerDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/logo_white" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Quantity and Unit Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Quantity"
                app:boxStrokeColor="@color/logo_gold"
                app:hintTextColor="@color/logo_gold_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/logo_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/spinner_background"
                android:entries="@array/measurement_units"
                android:popupBackground="@drawable/spinner_dropdown_bg" />
        </LinearLayout>

        <!-- Supplier -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Select Assigned Supplier / Worker"
            android:textColor="@color/logo_white"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerSupplier"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/spinner_background"
            android:popupBackground="@drawable/spinner_dropdown_bg" />

        <!-- Status -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:enabled="false"
            android:hint="Status"
            app:boxStrokeColor="@color/logo_gold"
            app:hintTextColor="@color/logo_gold_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:editable="false"
                android:text="Pending"
                android:textColor="@color/logo_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date and Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Date"
                app:boxStrokeColor="@color/logo_gold"
                app:hintTextColor="@color/logo_gold_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/imgCalender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:textColor="@color/logo_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Time"
                app:boxStrokeColor="@color/logo_gold"
                app:hintTextColor="@color/logo_gold_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:textColor="@color/logo_white" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Notes (Optional)"
            app:boxStrokeColor="@color/logo_gold"
            app:hintTextColor="@color/logo_gold_light"
            app:startIconDrawable="@drawable/ic_edit"
            app:startIconTint="@color/logo_gold">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:minLines="2"
                android:textColor="@color/logo_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateItem"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="REGISTER DAILY ISSUE"
                android:textColor="@color/logo_dark_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/logo_gold"
                app:cornerRadius="16dp"
                app:elevation="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseItem"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Close"
                android:textColor="@color/logo_white"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                app:strokeColor="#40FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>