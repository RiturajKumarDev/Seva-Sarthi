<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg_founder_header"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dialog Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/btnCloseDialog"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/profile_avatar_frame"
                        android:padding="3dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="@color/logo_dark_blue"
                            app:cardCornerRadius="33dp">

                            <ImageView
                                android:id="@+id/ivDialogProfile"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:contentDescription="Officer Profile"
                                android:src="@drawable/ic_officer"
                                app:tint="@color/logo_gold" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:contentDescription="Online Status"
                        android:elevation="6dp"
                        android:src="@drawable/circle_shape_green" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDialogName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Officer Name"
                        android:textColor="@color/logo_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#33E8C44B"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="EXECUTIVE OFFICER"
                        android:textColor="@color/logo_gold"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="#20FFFFFF"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/logo_white" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginBottom="14dp"
            android:background="#20FFFFFF" />

        <!-- Details Container Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1AFFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Department & Designation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Department"
                        android:textColor="@color/logo_gold_light"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDialogDepartment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="N/A"
                        android:textColor="@color/logo_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Designation"
                        android:textColor="@color/logo_gold_light"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDialogDesignation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="N/A"
                        android:textColor="@color/logo_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- District & Division -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="District"
                        android:textColor="@color/logo_gold_light"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDialogDistrict"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="N/A"
                        android:textColor="@color/logo_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Division"
                        android:textColor="@color/logo_gold_light"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDialogDivision"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="N/A"
                        android:textColor="@color/logo_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/logo_gold_light" />

                <TextView
                    android:id="@+id/tvDialogEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="email@example.com"
                    android:textColor="@color/logo_white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/logo_gold_light" />

                <TextView
                    android:id="@+id/tvDialogPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+91 9876543210"
                    android:textColor="@color/logo_white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/logo_gold_light" />

                <TextView
                    android:id="@+id/tvDialogAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Office Address"
                    android:textColor="@color/logo_white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogCall"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:paddingHorizontal="8dp"
                android:text="Call"
                android:textColor="@color/logo_green"
                android:textSize="13sp"
                app:icon="@drawable/ic_phone"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/logo_green"
                app:strokeColor="@color/logo_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogEmail"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="@color/logo_gold"
                android:paddingHorizontal="8dp"
                android:text="Email"
                android:textColor="@color/logo_dark_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_email"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/logo_dark_blue" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>